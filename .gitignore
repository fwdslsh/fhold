# Dependencies and generated build/test output.
node_modules/
packages/*/build/
packages/*/dist/
packages/*/coverage/
packages/*/test-results/
test-results/
.cache/
website/dist/
package-lock.json

# Instance homes and local credentials never belong in source control.
.fhold/
.env
.env.*
!.env.example
.private/
.dev/
.dev-*/
.dev_*/
.tmp/

# Local editor and agent state.
.vscode/
.opencode/
.claude/
.reviews/

# Generated by the CLI's pack:embedded script.
/packages/cli/embedded/
