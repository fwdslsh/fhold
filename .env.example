# fhold development environment
# Copy to .env only for local development. Never put credentials here.

FH_HOME=.dev

# Optional image/build pins
# FH_IMAGE_NAMESPACE=fhold
# FH_ASSISTANT_VERSION=dev
# FH_GUARDIAN_VERSION=dev
# FH_PORTAL_VERSION=dev

# Installed network, policy and connection choices are managed through the CLI
# or Admin and persisted in state/stack.json. state/stack.env is derived input,
# not another operator configuration interface. See docs/managing-fhold.md.
