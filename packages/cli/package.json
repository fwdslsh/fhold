{
  "name": "fhold",
  "version": "0.3.261008-beta",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "fhold CLI — install and manage a self-hosted fhold stack",
  "repository": {
    "type": "git",
    "url": "https://github.com/fwdslsh/fhold.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fwdslsh/fhold",
  "scripts": {
    "start": "bun run src/main.ts",
    "test": "bun test --isolate src/main.test.ts src/commands/*.test.ts src/compiled-boundary.test.ts src/lib/*.test.ts",
    "typecheck": "tsc --noEmit",
    "install:local": "bun run src/main.ts install --no-start",
    "pack:embedded": "bun run scripts/pack-embedded-assets.ts",
    "build": "bun run scripts/build.ts",
    "build:helpers": "bun run scripts/build.ts --helpers-only",
    "build:linux-x64": "bun run scripts/build.ts --target=bun-linux-x64",
    "build:linux-arm64": "bun run scripts/build.ts --target=bun-linux-arm64"
  },
  "devDependencies": {
    "@fhold/lib": "workspace:*",
    "@types/node": "^26.6.5",
    "bun-types": "^1.4.4",
    "citty": "^0.2.2",
    "tar": "^7.5.22",
    "typescript": "^7.0.2"
  }
}
