{
	"configVersion": "0.9.0",
	"bundles": {
		"stash": { "path": "/stash", "writable": true, "components": { "main": { "adapter": "akm" } } },
		"fhold": {
			"path": "/fhold-bundle",
			"writable": false,
			"components": { "skills": { "root": "skills", "adapter": "agent-skills", "writable": false } }
		}
	},
	"defaultBundle": "stash",
	"defaultWriteTarget": "stash",
	"harnesses": {
		"opencode": { "args": ["run", "--standalone"] }
	},
	"scheduler": {
		"enabled": []
	}
}
