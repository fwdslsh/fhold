{
	"configVersion": "0.9.0",
	"bundles": {
		"stash": { "path": "/stash", "writable": true, "adapter": "akm" },
		"fhold": {
			"path": "/fhold-bundle",
			"writable": false,
			"root": "skills",
			"adapter": "agent-skills"
		}
	},
	"defaultBundle": "stash",
	"defaultWriteTarget": "stash",
	"usage": { "report": true },
	"plugins": {
		"redact": { "pii": true, "highEntropy": true }
	},
	"harnesses": {
		"opencode": { "args": ["run", "--standalone"] }
	},
	"scheduler": {
		"enabled": []
	}
}
