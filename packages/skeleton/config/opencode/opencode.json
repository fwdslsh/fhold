{
	"$schema": "https://opencode.ai/config.json",
	"permissions": [
		{ "action": "shell", "resource": "*", "effect": "allow" },
		{ "action": "shell", "resource": "rm -r *", "effect": "ask" },
		{ "action": "shell", "resource": "rm -rf *", "effect": "ask" },
		{ "action": "shell", "resource": "rm -fr *", "effect": "ask" },
		{ "action": "shell", "resource": "sudo *", "effect": "ask" },
		{ "action": "edit", "resource": "*", "effect": "allow" },
		{ "action": "subagent", "resource": "*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/work/*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/stash/*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/fhold-bundle/*", "effect": "allow" },
		{ "action": "external_directory", "resource": "/etc/akm/*", "effect": "allow" },
		{
			"action": "external_directory",
			"resource": "/home/fhold/.config/opencode/*",
			"effect": "allow"
		}
	],
	"experimental": {
		"policies": [
			{ "action": "tool.use", "resource": "shell:rm -rf /", "effect": "deny" },
			{ "action": "tool.use", "resource": "shell:rm -fr /", "effect": "deny" }
		]
	}
}
